# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Supabase (backend/server-side only) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key bypasses Row Level Security. Never expose it to any client/frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
SECRET_KEY=

# --- Meta / Messenger (configured later) ---
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# --- AI (configured later) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
